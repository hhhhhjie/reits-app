{
  "name": "zhixing-markets",
  "version": "1.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/expo.cjs start",
    "android": "node scripts/expo.cjs start --android",
    "web": "node scripts/expo.cjs start --web",
    "api": "tsx server/index.ts",
    "dev": "concurrently -k \"npm:api\" \"npm:web\"",
    "build": "node scripts/expo.cjs export --platform web",
    "build:native": "node scripts/expo.cjs export --platform android --output-dir dist-native",
    "serve": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "build:android": "npx --yes eas-cli@25.2.0 build --platform android --profile preview",
    "build:apk:local": "bash scripts/build-apk.sh",
    "prebuild:android": "node scripts/expo.cjs prebuild --platform android --no-install",
    "test:live": "tsx scripts/check-live.ts",
    "test:android-data": "tsx scripts/check-android-data.ts",
    "test:universe": "tsx scripts/check-universe.ts"
  },
  "dependencies": {
    "@kayahr/text-encoding": "^2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "express": "^4.21.2",
    "lucide-react-native": "1.59.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/react": "~19.1.10",
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
